{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "s2-command",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Routes do nothing while a hostname's DNS record is grey-cloud (DNS-only, pointing at Railway); the switch is turning the proxy
  // on for that record. The real hostname (command.smartsyndicator.com) is NOT listed: it is added at the cutover (docs/cutover-runbook.md).
  "routes": [
    { "pattern": "command-staging.smartsyndicator.com/*", "zone_name": "smartsyndicator.com" }
  ],
  // Preview URLs are not wanted: the only public addresses are the workers.dev one and the real domain.
  "preview_urls": false,
  // The bundler swaps process.env.NODE_ENV for "development" unless told otherwise, and the app behaves differently in development.
  "define": { "process.env.NODE_ENV": "\"production\"" },
  // The real iconv-lite breaks in Workers (see the note in the shim), so this smaller stand-in is used instead.
  "alias": { "iconv-lite": "./worker/shims/iconv-lite.cjs" },
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // Private values are set with `wrangler secret put` and never written here.
  "vars": {
    "NODE_ENV": "production",
    "CF_WORKER": "1",
    "BETTER_AUTH_URL": "https://command.smartsyndicator.com"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // The S2 Command database `s2command` on the shared PlanetScale server, limited runtime role, query caching off,
      // origin connection limit 5 (created 2026-10-23).
      "id": "a3e4e784d51d42a6b053169ee3df2d84",
      "localConnectionString": "postgresql://frost:frost@127.0.0.1:5433/s2_cf"
    }
  ],
  // The staging/real routes are added by the provisioning steps (docs/migration-notes.md).
  // Every 15 minutes: the sync engine and metrics warm-up the Node server ran on a timer. Inert until JOBS_ENABLED=1.
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
